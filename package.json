{
  "name": "lab-5-mongodb",
  "version": "1.0.0",
  "type": "module",
  "description": "Event Manager API with MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:db": "node test-db-connection.js",
    "test:queries": "node test-database-queries.js",
    "test": "npm run test:db && npm run test:queries",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write 'src/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js'",
    "performance": "node test-performance.js",
    "security": "npm audit",
    "prepare": "sh -c \"if [ \"$CI\" = \"true\" ] || [ \"$NODE_ENV\" = \"production\" ]; then echo 'Skipping husky in CI/production'; else husky install; fi\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.2"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  }
}
